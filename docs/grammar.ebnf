program = { separator }, [ statement_sequence ], { separator }, EOF ;
statement_sequence = statement, { separators, statement } ;
body = { separator }, statement_sequence, { separator } ;
separator = NEWLINE | SEMICOLON ;
separators = separator, { separator } ;

statement = declaration | assignment | if_statement | short_if_statement
          | while_loop | for_loop | infinite_loop | exit_statement
          | return_statement | print_statement ;

declaration = KW_VAR, variable_definition, { COMMA, variable_definition } ;
variable_definition = IDENT, [ ASSIGN, expression ] ;
assignment = reference, ASSIGN, expression ;

if_statement = KW_IF, expression, KW_THEN, body,
               [ KW_ELSE, body ], KW_END ;

short_if_statement = KW_IF, expression, FAT_ARROW, statement ;
while_loop = KW_WHILE, expression, loop_body ;
for_loop = for_header, loop_body ;
for_header = KW_FOR, [ IDENT, KW_IN ], expression, [ RANGE, expression ] ;
infinite_loop = loop_body ;
loop_body = KW_LOOP, body, KW_END ;
exit_statement = KW_EXIT ;
return_statement = KW_RETURN, [ expression ] ;
print_statement = KW_PRINT, expression, { COMMA, expression } ;

expression = relation, { logical_operator, relation } ;
logical_operator = KW_OR | KW_AND | KW_XOR ;
relation = additive_expression, [ relational_operator, additive_expression ] ;
relational_operator = LESS | LESS_EQUAL | GREATER | GREATER_EQUAL
                    | EQUAL | NOT_EQUAL ;

additive_expression = multiplicative_expression,
                      { additive_operator, multiplicative_expression } ;
additive_operator = PLUS | MINUS ;
multiplicative_expression = unary_expression,
                            { multiplicative_operator, unary_expression } ;
multiplicative_operator = STAR | SLASH ;

unary_expression = reference, [ KW_IS, type_indicator ]
                 | [ unary_operator ], primary ;
unary_operator = PLUS | MINUS | KW_NOT ;
primary = literal | function_literal | LPAREN, expression, RPAREN ;
type_indicator = KW_INT | KW_REAL | KW_BOOL | KW_STRING | KW_NONE
               | LBRACKET, RBRACKET | LBRACE, RBRACE | KW_FUNC ;

function_literal = KW_FUNC, [ parameter_declarations ], function_body ;
parameter_declarations = LPAREN, IDENT, { COMMA, IDENT }, RPAREN ;
function_body = KW_IS, body, KW_END | FAT_ARROW, expression ;

reference = IDENT, { reference_suffix } ;
reference_suffix = array_index | function_call | tuple_field ;
array_index = LBRACKET, expression, RBRACKET ;
function_call = LPAREN, expression, { COMMA, expression }, RPAREN ;
tuple_field = DOT, ( IDENT | INTEGER ) ;

literal = INTEGER | REAL | STRING | boolean_literal | KW_NONE
        | array_literal | tuple_literal ;
boolean_literal = KW_TRUE | KW_FALSE ;

array_literal = LBRACKET, line_breaks,
                [ expression, { aggregate_comma, expression } ],
                line_breaks, RBRACKET ;

tuple_literal = LBRACE, line_breaks, tuple_element,
                { aggregate_comma, tuple_element }, line_breaks, RBRACE ;
tuple_element = [ IDENT, ASSIGN ], expression ;
aggregate_comma = line_breaks, COMMA, line_breaks ;
line_breaks = { NEWLINE } ;
